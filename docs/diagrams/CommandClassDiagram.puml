@startuml CommandClassDiagram
' Representative command inheritance and ledger references.
' Logical groups are shown, not the full Java package structure.
hide circle
hide empty members
skinparam classAttributeIconSize 0

package "Commands" {
    abstract class Command {
        + {abstract} execute(...): void
    }

    class BalanceCommand
    class DepositCommand
}

package "Ledger model" {
    class TransactionList
    class Transaction
    class Money
}

Command <|-- BalanceCommand
Command <|-- DepositCommand
Command .right.> TransactionList: uses
DepositCommand .right.> Transaction: creates

' Keep the transaction-creating command nearest the ledger model.
BalanceCommand -[hidden]right-> DepositCommand

TransactionList --> "0..*" Transaction: transactions
TransactionList --> "1" Money: openingBalance
Transaction --> "1" Money: amount

note bottom of BalanceCommand
    Other command subclasses
    and private members are omitted.
end note
@enduml
