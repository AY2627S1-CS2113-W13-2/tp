@startuml SetupSequenceDiagram
actor User
participant ":FinNUS" as FinNUS
participant "setup:Setup" as Setup
participant "ui:Ui" as Ui
participant "<<class>>\nParser" as Parser
participant "transactions:TransactionList" as Ledger

FinNUS -> Setup: run(ui, transactions)
activate Setup
loop until confirmed or input ends
    Setup -> Ui: readCommand("Opening balance (SGD): ")
    Ui --> User: amount prompt
    User -> Ui: amount
    Ui --> Setup: input
    alt input ended
        Setup --> FinNUS: false
    else amount entered
        Setup -> Parser: parseNonNegativeAmount(input)
        alt invalid amount
            Parser --> Setup: validation error
            Setup -> Ui: showError(message)
            Ui --> User: error; amount prompt repeats
        else valid amount
            Parser --> Setup: Money amount
            Setup -> Setup: confirmBalance(ui, amount)
            loop until valid answer or input ends
                Setup -> Ui: readCommand("Confirm amount? [yes/no]")
                Ui --> User: confirmation prompt
                User -> Ui: yes / no / invalid answer
                Ui --> Setup: answer
                opt invalid answer
                    Setup -> Ui: showError("Please answer yes or no.")
                    Ui --> User: confirmation error
                end
            end
            alt input ended during confirmation
                Setup --> FinNUS: false
            else no / n
                note right of Setup: Return to the opening balance prompt.
            else yes / y
                create "command:OpeningBalanceCommand" as Opening
                Setup -> Opening: new OpeningBalanceCommand(amount)
                Setup -> Opening: execute(transactions, ui)
                Opening -> Ledger: setOpeningBalance(amount)
                Setup -> Setup: askForAllowance(...)
                note right of Setup: Optional; the user may skip it.
                Setup --> FinNUS: true
            end
        end
    end
end
deactivate Setup
@enduml
' @@author
